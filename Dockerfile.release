# The tag documents the expected JDK while the digest keeps the builder immutable.
FROM eclipse-temurin:25-jdk@sha256:97014c4b396021f9ddb7d592a7dbedb0c4e4215c29e03dc01c393558aefb71c2 AS builder

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . .

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    set -euo pipefail; \
    ./gradlew --no-daemon -Pinclude-frontend=true :api:bootJar; \
    mapfile -t jars < <( \
      find api/build/libs -maxdepth 1 -type f \
        -name 'api-*.jar' ! -name '*-plain.jar' \
    ); \
    if (( ${#jars[@]} != 1 )); then \
      echo "Expected exactly one Kafka UI Boot JAR, found ${#jars[@]}." >&2; \
      exit 1; \
    fi; \
    mkdir -p /out; \
    cp "${jars[0]}" /out/api.jar

# The tag is retained for discoverability and the digest ensures immutability.
FROM azul/zulu-openjdk-alpine:25.0.3-jre-headless@sha256:49813322612bed550f4540a5b06dd5ea3b9ac1aa6d8842cad6b289777ca825c4

RUN apk add --no-cache \
    gcompat \
    tzdata
RUN addgroup -S kafkaui && adduser -S kafkaui -G kafkaui
RUN mkdir /etc/kafkaui/ && chown kafkaui /etc/kafkaui

COPY --from=builder --chown=kafkaui:kafkaui /out/api.jar /api.jar

USER kafkaui

ENV JAVA_OPTS=

EXPOSE 8080

# See JmxSslSocketFactory docs to understand why add-opens is needed.
CMD ["sh", "-c", "exec java --add-opens java.rmi/javax.rmi.ssl=ALL-UNNAMED $JAVA_OPTS -jar /api.jar"]
